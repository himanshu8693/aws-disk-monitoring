# Member account: Acquired Co A
# To add another account, copy this file and update the values below.
plugin: amazon.aws.aws_ec2

regions:
  - us-east-1
  - us-west-2

assume_role_arn: arn:aws:iam::111111111111:role/DiskMonitoringAutomationRole

filters:
  instance-state-name: running

keyed_groups:
  - key: tags['BusinessUnit'] | default('unassigned')
    prefix: bu
  - key: platform | default('linux')
    prefix: os

compose:
  # Use the instance's actual region — not a hardcoded value.
  # placement.region is provided by the aws_ec2 plugin for each discovered instance.
  ansible_aws_ssm_region: placement.region
  ansible_connection: "'amazon.aws.aws_ssm'"
  ansible_aws_ssm_bucket_name: "'disk-monitoring-ssm-acquired-co-a'"
  account_id: "'111111111111'"
  account_name: "'acquired-co-a'"

hostnames:
  - tag:Name
  - instance-id
